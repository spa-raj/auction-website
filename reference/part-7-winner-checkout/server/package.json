{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude '../node_modules/**' src/index.ts",
    "dev:close-worker": "tsx watch --exclude '../node_modules/**' src/close-worker.ts",
    "dev:notification-worker": "tsx watch --exclude '../node_modules/**' src/notification-worker.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "amqplib": "^2.0.1",
    "fastify": "^5.12.6",
    "pg": "^8.16.3",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
